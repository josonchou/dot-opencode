    },
    "ultrabrain": {
      "model": "openai/gpt-5.5",
      "variant": "xhigh",
      "fallback_models": [
        {
          "model": "github-copilot/gemini-3.1-pro-preview",
          "variant": "high",
        },
        {
          "model": "github-copilot/claude-opus-4.8",
          "variant": "max",
        },
        {
          "model": "opencode-go/glm-5.2",
        },
      ],
    },
    "deep": {
      "model": "openai/gpt-5.5",
      "variant": "medium",
      "fallback_models": [
        {
          "model": "github-copilot/claude-opus-4.8",
