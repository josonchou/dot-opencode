{
  "$schema": "https://opencode.ai/config.json",
  "instructions": [
    "AGENTS.md",
    "rules/*"
  ],
  "autoupdate": true,
  "agent": {
    "plan": {
      "model": "openai/gpt-5.6-terra"
    },
    "build": {
      "model": "openai/gpt-5.6-terra"
    },
    "explore": {
      "model": "openai/gpt-5.4-mini-fast",
      "disable": true
    },
    "general": {
      "disable": true
    }
  },
  "plugin": [
    "opencode-cmux@latest",
    "@warp-dot-dev/opencode-warp@0.1.5",
    "oh-my-opencode-slim"
  ],
  "references": {
    "omo": {
      "path": "./omo",
      "description": "OmO meta info"
    },
    "dyandriod": {
      "path": "/Users/joson/Workspace/douyu/DouyuAllComponent",
      "description": "The andriod project for douyu app"
    }
  },
  "mcp": {
    "ardot": {
      "url": "http://127.0.0.1:50501/api/v1/mcp",
      "type": "remote"
    },
    "feishu-mcp": {
      "type": "remote",
      "url": "{env:FEISHU_MCP_URL}",
      "enabled": false
    },
    "Framelink_Figma_MCP": {
      "type": "local",
      "command": [
        "bunx",
        "-y",
        "figma-developer-mcp",
        "--figma-api-key={env:MY_FIGMA_API_KEY}",
        "--stdio"
      ],
      "enabled": true
    },
    "fetch": {
      "type": "local",
      "command": [
        "bunx",
        "mcp-fetch-server"
      ],
      "environment": {
        "DEFAULT_LIMIT": "50000"
      },
      "enabled": false
    },
    "web-search": {
      "type": "local",
      "command": [
        "bunx",
        "open-websearch@latest"
      ],
      "environment": {
        "ALLOWED_SEARCH_ENGINES": "bing,juejin,baidu,csdn,brave",
        "DEFAULT_SEARCH_ENGINE": "bing",
        "MODE": "stdio"
      },
      "enabled": false
    },
    "dart": {
      "type": "local",
      "command": [
        "dart",
        "mcp-server",
        "--force-roots-fallback"
      ],
      "enabled": false
    },
    "codegraph": {
      "type": "local",
      "command": [
        "codegraph",
        "serve",
        "--mcp"
      ],
      "enabled": true
    }
  },
  "lsp": {
    "json": {
      "command": [
        "vscode-json-languageserver",
        "--stdio"
      ],
      "extensions": [
        "json",
        "jsonc"
      ]
    }
  }
}
